nswer.Answer2"},{"#f":5}],"c-1":["ev",{"^->":"9th_Choice2.0.c-1.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.1.s"},[{"#n":"$r2"}],"\n",{"->":"9th_Answer.Answer2"},{"#f":5}],"c-2":["ev",{"^->":"9th_Choice2.0.c-2.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.2.s"},[{"#n":"$r2"}],"\n",{"->":"9th_Answer.Answer2"},{"#f":5}]}],{"#f":1}],"9th_Dialog3_Evidence":["^弟弟:但像這些筆記上記錄的當沖與對沖步驟，你看起來完全信任對方的指令。","\n","^哥哥:上面記錄的是跟著大戶當沖與對沖的步驟，能有效降低單一市場的風險。","\n",{"->":"9th_Evidence_Choice1"},{"#f":1}],"9th_Evidence_Choice1":[[["ev",{"^->":"9th_Evidence_Choice1.0.0.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-0","flg":2},{"s":["^能看到你積極規劃財務很好，但現在很多帶單詐騙，我們一起多看一眼確認安全性。",{"->":"$r","var":true},null]}],["ev",{"^->":"9th_Evidence_Choice1.0.1.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-1","flg":2},{"s":["^當沖跟對沖需要極高的專業，光靠別人的指導跟單風險非常高。",{"->":"$r","var":true},null]}],["ev",{"^->":"9th_Evidence_Choice1.0.2.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-2","flg":2},{"s":["^什麼大戶帶單都是騙人的話術，你以為靠這些筆記就能在股市賺錢？",{"->":"$r","var":true},null]}],{"c-0":["ev",{"^->":"9th_Evidence_Choice1.0.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.0.s"},[{"#n":"$r2"}],"\n",{"->":"9th_Answer.Answer3"},{"#f":5}],"c-1":["ev",{"^->":"9th_Evidence_Choice1.0.c-1.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.1.s"},[{"#n":"$r2"}],"\n",{"->":"9th_Answer.Answer3"},{"#f":5}],"c-2":["ev",{"^->":"9th_Evidence_Choice1.0.c-2.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.2.s"},[{"#n":"$r2"}],"\n",{"->":"9th_Answer.Answer3"},{"#f":5}]}],{"#f":1}],"9th_Dialog4":["^弟弟:但不管是這些資料還是交易模式，沒有經過第三方監管驗證就很難令人安心。","\n","^哥哥:我研究這些都是為了讓未來的財務狀況更穩定，這沒什麼好焦慮的。","\n","^弟弟:正因為關心你的未來，我才希望在資金投入前能多一道確認手續。","\n","^哥哥:我已經不是小孩了，知道怎麼評估風險，不需要每件事都反覆懷疑。","\n",{"->":"9th_Choice3"},{"#f":1}],"9th_Choice3":[[["ev",{"^->":"9th_Choice3.0.0.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-0","flg":2},{"s":["^最近針對想改善生活的人的金融詐騙很多，我們一起確保這項計畫跟聽起來一樣安全。",{"->":"$r","var":true},null]}],["ev",{"^->":"9th_Choice3.0.1.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-1","flg":2},{"s":["^只看獲利預期卻忽略平台背景，這種評估方式本身就有巨大的漏洞。",{"->":"$r","var":true},null]}],["ev",{"^->":"9th_Choice3.0.2.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-2","flg":2},{"s":["^你每次都說知道風險，結果還不是一直被牽著鼻子走，根本沒有判斷能力。",{"->":"$r","var":true},null]}],{"c-0":["ev",{"^->":"9th_Choice3.0.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.0.s"},[{"#n":"$r2"}],"\n",{"->":"9th_Answer.Answer3"},{"#f":5}],"c-1":["ev",{"^->":"9th_Choice3.0.c-1.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.1.s"},[{"#n":"$r2"}],"\n",{"->":"9th_Answer.Answer3"},{"#f":5}],"c-2":["ev",{"^->":"9th_Choice3.0.c-2.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.2.s"},[{"#n":"$r2"}],"\n",{"->":"9th_Answer.Answer3"},{"#f":5}]}],{"#f":1}],"9th_Dialog5":["^弟弟:但只看當前的運作順利，並不代表能完全排除隱含的風險。","\n","^哥哥:這幾天測試下來收益都很正常，你不用一直抱持著懷疑的態度。","\n","^弟弟:防範於未然總比事後虧損好，我只是希望能多幫你確認一次。","\n","^哥哥:我的事情我自己會負責，沒必要把簡單的事情複雜化。","\n",{"->":"9th_Choice4"},{"#f":1}],"9th_Choice4":[[["ev",{"^->":"9th_Choice4.0.0.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-0","flg":2},{"s":["^我很支持你想要改善生活的想法，只是希望能成為幫你把關的安全網。",{"->":"$r","var":true},null]}],["ev",{"^->":"9th_Choice4.0.1.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-1","flg":2},{"s":["^在還沒真正把資金全額提現前，所有的收益數據都不能當作安全的依據。",{"->":"$r","var":true},null]}],["ev",{"^->":"9th_Choice4.0.2.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-2","flg":2},{"s":["^你再這樣固執不聽勸，等所有錢都被騙光的時候，看你還要怎麼負責。",{"->":"$r","var":true},null]}],{"c-0":["ev",{"^->":"9th_Choice4.0.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.0.s"},[{"#n":"$r2"}],"\n",{"->":"9th_Answer.Answer4"},{"#f":5}],"c-1":["ev",{"^->":"9th_Choice4.0.c-1.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.1.s"},[{"#n":"$r2"}],"\n",{"->":"9th_Answer.Answer4"},{"#f":5}],"c-2":["ev",{"^->":"9th_Choice4.0.c-2.$r2"},"/ev",{"temp=":"$r"},{"->":